# ==========================================================================
# DEMONFX — server environment (copy to .env for local dev, never commit it)
# On Cloudflare use: npx wrangler secret put NAME
# ==========================================================================

# --- Payment (Stripe Checkout) -------------------------------------------
# Dashboard -> Developers -> API keys. Use the test-mode key while testing.
# Paste the value after the "="; never commit a real key.
STRIPE_SECRET_KEY=
# Signing secret from the webhook endpoint you create for /api/stripe-webhook.
STRIPE_WEBHOOK_SECRET=

# Price in the smallest currency unit (e.g. 24900 = 249.00).
# TODO: replace with the final confirmed course price.
COURSE_PRICE_CENTS=
COURSE_CURRENCY=usd
COURSE_NAME=Forex Trading Masterclass

# Public origin used for Stripe success/cancel redirects.
# TODO: set to the live site, e.g. https://www.demonfx.com
PUBLIC_SITE_URL=http://localhost:4173

# Optional comma-separated extra origins allowed to POST to the API.
ALLOWED_ORIGIN=

# --- Transactional email --------------------------------------------------
# Any Resend-compatible HTTP endpoint works; see README for the request shape.
RESEND_API_KEY=
EMAIL_FROM=Demonfx <courses@example.com>
ENQUIRY_TO=hello@example.com

# --- Local development ----------------------------------------------------
# DEV_MODE=1 captures enquiries in .local/enquiries.jsonl instead of emailing.
DEV_MODE=1
